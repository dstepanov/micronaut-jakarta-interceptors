<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--

  The interception of this module never reflects: an interceptor method is invoked through the executable method
  Micronaut generated for it, a chain is read from annotation metadata, and a binding is compared as a string.
  Only the accessors of jakarta.interceptor.InvocationContext reach for the reflection of the platform, because
  the types the specification has them return leave no choice, and each of those is written down.

  This configuration fails the build on a new one. It is deliberately NOT config/checkstyle/checkstyle.xml: that
  file is shared across the Micronaut projects and replaced wholesale whenever the common files are synchronised,
  which would silently take these rules with it. It has a directory and a Checkstyle task of its own so that the
  synchronisation has nothing here to overwrite.

  Where reflection is genuinely required, say so on the line before it or at its end:

      // reflection: the specification returns a java.lang.reflect.Method
      return context.getExecutableMethod().getTargetMethod();

  The comment is the point. It is not a way to silence the check but a record of why the platform had to be asked,
  which is what makes the remaining uses reviewable.

-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">

        <!-- a member looked up on a class, which inflates every declared member of it into the reflection data
             the virtual machine keeps for that class -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoReflectiveMemberLookup"/>
            <!-- the public lookups take the member name, and an InvocationContext of this module declares a
                 getMethod() and a getConstructor() of its own that take nothing; requiring an argument tells the
                 two apart -->
            <property name="format" value="\.(getDeclaredMethods?|getDeclaredConstructors?|getDeclaredFields?)\(|\.getMethods\(|\.getConstructors\(|\.getFields\(|\.(getMethod|getConstructor|getField)\(\s*[^)\s]"/>
            <property name="message" value="Reflective member lookup. The interception is resolved at compilation time and dispatched through generated code; where the specification leaves no way around this, say why with a // reflection: comment."/>
        </module>

        <!-- the accessibility flag, and instantiation that bypasses the bean context -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoReflectiveAccess"/>
            <property name="format" value="\.setAccessible\(|\.newInstance\(|Class\.forName\("/>
            <property name="message" value="Reflective access or instantiation. An interceptor class is a bean and comes from the bean context; where the specification leaves no way around this, say why with a // reflection: comment."/>
        </module>

        <!-- the annotations of a class, read from the class rather than from the metadata Micronaut compiled -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoReflectiveAnnotationRead"/>
            <!-- The plural forms, and the ones no metadata declares. -->
            <property name="format" value="\.(isAnnotationPresent|getDeclaredAnnotations|getAnnotationsByType|getDeclaredAnnotationsByType)\(|\.getAnnotations\(\)|MethodHandles\."/>
            <property name="message" value="Annotations read from a class. Read them from the AnnotationMetadata Micronaut compiled instead, which answers having read nothing."/>
        </module>

        <!-- The singular getAnnotation and getDeclaredAnnotation cannot be forbidden by name: AnnotationMetadata
             declares both, reading what Micronaut compiled rather than asking the platform, and the resolver and
             the processor are built on them. What can be forbidden is the receiver, and a class reached as a
             literal or through getClass() is unambiguously the platform being asked.

             What this leaves is a receiver held in a Class variable - annotationType.getAnnotation(X.class) -
             which reads identically to a metadata call on a line of its own. Telling those apart needs the type
             of the receiver, which Checkstyle does not resolve; an ErrorProne check would. That gap is the one
             this configuration knows about and cannot close. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoAnnotationReadFromAClass"/>
            <property name="format" value="(\.class|getClass\(\))\.(getAnnotation|getDeclaredAnnotation|getAnnotations|getDeclaredAnnotations|getAnnotationsByType|getDeclaredAnnotationsByType|isAnnotationPresent)\("/>
            <property name="message" value="Annotations read from a class. Read them from the AnnotationMetadata Micronaut compiled instead, which answers having read nothing."/>
        </module>

        <!-- building an annotation instance defines a dynamic proxy class that lives as long as its class loader -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoAnnotationSynthesis"/>
            <property name="format" value="\.synthesize|Proxy\.newProxyInstance\("/>
            <property name="message" value="Building an annotation instance defines a proxy class for the life of the class loader. Read the member from the AnnotationMetadata instead; where the specification asks for the annotation itself, say so with a // reflection: comment."/>
        </module>

        <!-- resolving the java.lang.reflect.Method of an executable method, which Micronaut looks up reflectively -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoTargetMethodResolution"/>
            <property name="format" value="\.getTargetMethod\("/>
            <property name="message" value="Resolving the target method of an executable method looks it up reflectively. The ExecutableMethod itself describes the declaring type, the name, the arguments and the annotations without reflecting; where the specification asks for a java.lang.reflect.Method, say so with a // reflection: comment."/>
        </module>

        <!-- the escape hatch: a comment on the line before, or at the end of the line itself, saying why -->
        <module name="SuppressWithNearbyCommentFilter">
            <property name="commentFormat" value="reflection:"/>
            <!-- every check here is a RegexpSinglelineJava; the id names which one, and a comment filter matches
                 on the check name rather than the id -->
            <property name="checkFormat" value="RegexpSinglelineJava"/>
            <property name="influenceFormat" value="1"/>
        </module>
        <module name="SuppressWithNearbyCommentFilter">
            <property name="commentFormat" value="reflection:"/>
            <!-- every check here is a RegexpSinglelineJava; the id names which one, and a comment filter matches
                 on the check name rather than the id -->
            <property name="checkFormat" value="RegexpSinglelineJava"/>
            <property name="influenceFormat" value="0"/>
        </module>

    </module>
</module>
